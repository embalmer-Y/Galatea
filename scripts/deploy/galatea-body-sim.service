[Unit]
Description=Galatea body simulator publisher (gbridge namespace; Q-L13-16④ honest source label)
After=network-online.target galatea-zenohd.service
Wants=galatea-zenohd.service

[Service]
Type=simple
User=emb
WorkingDirectory=/home/emb/project/galatea-service
Environment=PATH=/home/emb/.local/bin:/usr/bin:/bin
ExecStart=/home/emb/.local/bin/uv run --directory /home/emb/project/galatea-service python scripts/body_publisher.py --duration 0 --router tcp/127.0.0.1:7447
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
